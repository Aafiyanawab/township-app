# Database connection; use a local PostgreSQL URL or SQLite URL for development.
DATABASE_URL=sqlite:///./dev.db
# Replace locally with a long random value; never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret
# JWT lifetime in minutes.
JWT_EXPIRE_MINUTES=60
# Use mock only for local/demo OTP login.
OTP_MODE=mock
# Optional Gemini / Anthropic credentials for complaint classification.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides; defaults are used when omitted.
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL=claude-haiku-5-5
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Seed demo rows on startup only when the flats table is empty.
SEED_ON_START=false
# Runtime environment label.
ENV=development
# HTTP port; the hosting platform sets this in production.
PORT=8000
